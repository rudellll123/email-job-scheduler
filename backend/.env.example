NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgres://outbox:outbox@localhost:5432/outbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

JWT_SECRET=change-me-to-a-long-random-string-32chars+
# 32 bytes, hex encoded (openssl rand -hex 32). Encrypts SMTP passwords and Slack tokens.
ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- Throughput / rate limiting (all configurable, nothing hardcoded) ---
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the SAME sender
MIN_DELAY_SECONDS=2
# Ceiling per sender per clock hour; a batch may request lower, never higher
MAX_EMAILS_PER_HOUR_PER_SENDER=200
